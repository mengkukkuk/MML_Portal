# Copy to .env and fill in real values. Do NOT commit .env.

# --- Local PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Seconds to wait for a TCP connect before giving up. Keep this small: without
# it a powered-off database host blocks on the OS timeout instead of failing.
DB_CONNECT_TIMEOUT=5

# --- Database failover (optional) ---
# If the primary above is unreachable, the API automatically switches to the
# fallbacks below, in order, so the service keeps running and users can log in.
# Any key you leave out is inherited from the primary, so usually only the host
# is needed. Number them from 1 with no gaps.
#
#   DB_FALLBACK_1_HOST=192.168.1.50
#   DB_FALLBACK_1_PORT=5432
#   DB_FALLBACK_1_NAME=MMLData
#   DB_FALLBACK_1_USER=postgres
#   DB_FALLBACK_1_PASSWORD=
#
# IMPORTANT: a fallback must already have a `users` table or nobody can sign in
# after a failover. Seed it once, before you need it:
#
#   DB_TARGET=fallback1 venv\Scripts\python.exe seed_users.py
#
# Note that the app *writes* to whichever database it is using. Work saved while
# on a fallback stays there — it is not copied back to the primary. Returning to
# the primary is therefore manual: POST /api/system/db/failback (admin), or
# restart the service.
#
# Seconds to fail fast for after every candidate has failed, instead of
# retrying each host on every single request.
DB_FAILOVER_COOLDOWN=10

# --- JWT ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_EXPIRE_MIN=30
REFRESH_EXPIRE_DAYS=7
RESET_EXPIRE_MIN=30

# --- Account management ---
# Base URL of the frontend (used to build password-reset links in emails).
APP_BASE_URL=http://localhost:5173
MIN_PASSWORD_LEN=8

# --- Password-reset email delivery ---
# Priority: BREVO_API_KEY (preferred) > SMTP_HOST (legacy) > dev log.

# Brevo transactional HTTP API (recommended — no IP allow-list required).
# Generate at: Brevo dashboard → SMTP & API → API Keys → Generate a new API key.
# Token format: xkeysib-...
BREVO_API_KEY=

# --- SMTP fallback (used only when BREVO_API_KEY is empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From header; defaults to SMTP_USER if blank. Quoted display name is fine:
#   SMTP_FROM="SCADA <no-reply@example.com>"
SMTP_FROM=
# Connection security: starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10
