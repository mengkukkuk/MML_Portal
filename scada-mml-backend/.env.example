# Copy to .env and fill in real values. Do NOT commit .env.

# --- Application / configuration database ---
# There is deliberately NO DB_HOST / DB_USER / DB_PASSWORD here — the app's own
# configuration always lives on localhost:5432, user `postgres`. That is
# hardcoded in config.py and is what lets the app boot and log in even when
# every plant is unreachable.
#
# The database name and schema DO vary site to site (a customer's DBA may have
# already provisioned e.g. "mmllocal"/"localbase"), so those two are the one
# pair of knobs read from here. Leave unset for today's default of
# `postgres`/`public` — an existing install needs no change.
# APP_DB_NAME=postgres
# APP_DB_SCHEMA=public
#
# Plant data is NOT read from here. Add each plant as a saved connection under
# Settings → Data sources, then pick which ones to view from the header
# selector. A plant that goes down degrades that source only.

# Seconds to wait for a TCP connect before giving up — applies to plant
# datasources too. Keep this small: without it a powered-off plant host blocks
# on the OS timeout instead of failing.
DB_CONNECT_TIMEOUT=5

# Where the vision system drops categorized inspection frames, laid out as
#   <root>/<camera code>/NG/defect_<slot>/*.png
# Read-only to this app. Leave unset and the camera panel simply shows no
# frames — an install with no image share is a normal install, not an error.
#
# Under NSSM the service often runs as an account that cannot read a user
# profile directory, so prefer a path that account can actually reach.
# CAMERA_IMAGE_ROOT=D:\vision\tobacco_cam

# --- Connection pooling (optional) ---
# APP_DB_POOL_MIN=2
# APP_DB_POOL_MAX=10
# DS_POOL_MAX=5            # per selected plant datasource

# --- Multi-datasource fan-out (optional) ---
# FANOUT_MAX_WORKERS=8     # also caps total concurrent remote connections
# FANOUT_TIMEOUT_S=12
# MAX_SELECTED_DATASOURCES=8

# --- Encrypted secrets (dpapi: prefix, Windows installs only) ---
# On a Windows install of this app, any of ENCRYPTION_KEY, JWT_SECRET, BREVO_API_KEY, or
# SMTP_PASS below MAY be given as a value prefixed "dpapi:" instead of plaintext, e.g.:
#   SMTP_PASS=dpapi:AQAAANCMnd8BFdERjHoAwE/Cl+sBAAAA...
# This is a Windows DPAPI (LocalMachine scope) blob, decryptable only on the machine that
# created it, by any account on that machine. The offline installer generates this
# automatically for JWT_SECRET; for the others, type the plaintext value in below, then run
#   {install dir}\tools\protect-secret.ps1
# and replace it with the dpapi: line it prints. A value WITHOUT the dpapi: prefix is always
# read as plaintext -- nothing here requires the dpapi: form, it is optional hardening for a
# production install where standard users can browse to this folder.

# --- Secrets at rest (optional) ---
# Encrypts saved plant-datasource passwords in the app database. Leave blank
# to keep today's plaintext behaviour — nothing breaks either way.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# May also be given as dpapi:... -- see "Encrypted secrets" note above.
ENCRYPTION_KEY=

# --- JWT ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# May also be given as dpapi:... -- see "Encrypted secrets" note above.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_EXPIRE_MIN=30
REFRESH_EXPIRE_DAYS=7
RESET_EXPIRE_MIN=30

# --- Account management ---
# Base URL of the frontend (used to build password-reset links in emails).
APP_BASE_URL=http://localhost:5173
MIN_PASSWORD_LEN=8

# --- Password-reset email delivery ---
# Priority: BREVO_API_KEY (preferred) > SMTP_HOST (legacy) > dev log.

# Brevo transactional HTTP API (recommended — no IP allow-list required).
# Generate at: Brevo dashboard → SMTP & API → API Keys → Generate a new API key.
# Token format: xkeysib-...
# May also be given as dpapi:... -- see "Encrypted secrets" note above.
BREVO_API_KEY=

# --- SMTP fallback (used only when BREVO_API_KEY is empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# May also be given as dpapi:... -- see "Encrypted secrets" note above.
SMTP_PASS=
# From header; defaults to SMTP_USER if blank. Quoted display name is fine:
#   SMTP_FROM="SCADA <no-reply@example.com>"
SMTP_FROM=
# Connection security: starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_TIMEOUT=10

# --- Licensing (offline, signed license file; no phone-home, no license server) ---
# Where the activated license lives. Defaults to a location outside the app
# directory so it survives an app-directory wipe/reinstall. Usually left unset.
# LICENSE_FILE_PATH=C:\ProgramData\MMLPortal\license.lic

# Days before expires_at that the frontend shows a cosmetic "expiring soon"
# warning. Purely a UX heads-up — not signed, not enforced (unlike
# grace_period_days, which is part of the signed license payload).
LICENSE_WARNING_WINDOW_DAYS=14
