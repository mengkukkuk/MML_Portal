{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "scada-frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-8089",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_TARGET=http://127.0.0.1:8089 && npm --prefix scada-frontend run dev"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "scada-mml-backend/venv/Scripts/python.exe",
      "runtimeArgs": ["scada-mml-backend/main.py"],
      "port": 8088
    },
    {
      "name": "backend-8089",
      "runtimeExecutable": "scada-mml-backend/venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "main:app",
        "--app-dir", "scada-mml-backend",
        "--host", "127.0.0.1", "--port", "8089"
      ],
      "port": 8089
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "scada-frontend", "run", "preview"],
      "port": 4173
    }
  ]
}
