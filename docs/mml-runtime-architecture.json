  "cards": [
    {
      "dot": "cyan",
      "title": "Edge and session",
      "items": [
        "IIS + ARR sends /api/* to uvicorn :8088 and everything else to index.html",
        "Access JWT (30 min) stays in JS memory; the refresh JWT is an HttpOnly cookie on /api/auth",
        "A bundled install drops IIS — FastAPI serves dist/ from the same process"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two-database split",
      "items": [
        "The app/config DB is hardcoded to localhost — login and layouts survive a total plant outage",
        "sensor_readings, variables_tag, event_logs and alarm_logs are only ever read from a plant",
        "The header selection (max 8 plants) overrides any panel's stored datasource_id"
      ]
    },
    {
      "dot": "violet",
      "title": "Fan-out and failure",
      "items": [
        "db.fan_out runs one bounded worker per selected plant and stamps datasource_id on every row",
        "A failed plant is not an empty plant — each response carries a per-source ok/error report",
        "Only an insecure JWT_SECRET aborts startup; a dead DB or missing license degrades instead"
      ]
    }
  ]
