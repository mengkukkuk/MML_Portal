  "cards": [
    { "dot": "cyan", "title": "Boot order is load-bearing", "items": [
      "data-theme is read from localStorage before createRoot, so no palette flash",
      "The first render waits on one single-flight /auth/refresh — no /login flash",
      "A blocked license replaces the router instead of rendering as a route"
    ] },
    { "dot": "emerald", "title": "One key, one series", "items": [
      "The header's selectionKey rides in every query key, so a new plant reseeds",
      "First call per key seeds a window; later calls append and trim it",
      "Series are keyed by datasource id — plants reuse the same tag names"
    ] },
    { "dot": "violet", "title": "Failure is handled once", "items": [
      "A 401 refreshes once, queues the other requests, then replays them",
      "502/503/504 gets one 1.5s retry here, so Query itself never retries",
      "useHealthPoll polls /api/health unauthenticated every 15s"
    ] }
